# bootcfg: site network configuration, read at boot from the BOOT partition.
# Copy to /boot/net.cfg on the SD card and edit per machine. KEY=value only;
# values with spaces must be quoted.

INTERFACE=eth0
MACADDRESS=00:0a:35:00:00:01
IPADDRESS=192.168.138.101
NETMASK=255.255.255.0
# PREFIXLEN=24              # takes precedence over NETMASK
GATEWAY=192.168.138.1
DNS="192.168.138.254"
NTP="192.168.138.1"
