[Unit]
Description=Restore last known clock from /var/lib/clocksave/clock.save
# Boards without an RTC boot into the kernel's default time; the restored
# value is at most one save interval stale and is superseded by NTP as soon
# as it syncs. Running in the sysinit phase puts the restore before nearly
# everything else on the boot path. The file lives on the rootfs, so the only
# ordering this needs is PID1 having remounted it read-write.
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/var/lib/clocksave/clock.save

[Service]
Type=oneshot
ExecStart=@SBINDIR@/clocksave.sh restore

[Install]
WantedBy=sysinit.target
